<!-- ConScan Detail Page -->
<div id="conscan" class="page">
    <div class="container">
        <section>
            <a href="#" onclick="showPage('home')" class="back-button"
                >← Back to Home</a
            >
            <div class="conscan-detail">
                <h2 class="section-title">ConScan</h2>
                <p class="section-subtitle">
                    Enterprise-grade container security scanning for modern
                    DevOps teams
                </p>

                <div style="max-width: 900px; margin: 0 auto 3rem;">
                    <p
                        style="color: #6b7280; line-height: 1.8; font-size: 1.125rem;"
                    >
                        ConScan is our flagship container security solution
                        designed to protect your containerized applications
                        throughout the entire development lifecycle. With
                        comprehensive scanning capabilities and actionable
                        insights, ConScan helps you identify and remediate
                        security issues before they reach production.
                    </p>
                </div>

                <h3
                    style="text-align: center; font-size: 2rem; margin-bottom: 2rem; color: #1a1a1a;"
                >
                    Key Features
                </h3>

                <div class="feature-grid">
                    <div class="feature-detail-card">
                        <h3>🔍 Vulnerability Scanning</h3>
                        <p>
                            Comprehensive detection of known CVEs across all
                            layers of your container images. Stay ahead of
                            security threats with real-time vulnerability
                            intelligence from multiple trusted databases.
                        </p>
                    </div>

                    <div class="feature-detail-card">
                        <h3>🔐 Secret Detection</h3>
                        <p>
                            Identify exposed credentials, API keys, tokens, and
                            sensitive configuration data that could compromise
                            your application security. Prevent credential leaks
                            before deployment.
                        </p>
                    </div>

                    <div class="feature-detail-card">
                        <h3>💾 Storage Optimization</h3>
                        <p>
                            Analyze and identify inefficient file storage
                            patterns, unnecessary dependencies, and bloated
                            layers that increase image size and attack surface.
                        </p>
                    </div>

                    <div class="feature-detail-card">
                        <h3>📦 SBOM Generation</h3>
                        <p>
                            Generate complete Software Bill of Materials (SBOM)
                            for full transparency into all software components,
                            libraries, and dependencies in your container
                            images.
                        </p>
                    </div>

                    <div class="feature-detail-card">
                        <h3>📋 Package Inventory</h3>
                        <p>
                            Maintain detailed inventory of all OS packages and
                            application dependencies, enabling better license
                            compliance and dependency management.
                        </p>
                    </div>

                    <div class="feature-detail-card">
                        <h3>✅ CIS Benchmarks</h3>
                        <p>
                            Automated compliance checks against CIS Docker
                            Benchmarks and Kubernetes security best practices.
                            Ensure your containers meet industry security
                            standards.
                        </p>
                    </div>
                </div>

                <div style="max-width: 900px; margin: 4rem auto 0;">
                    <h3
                        style="font-size: 2rem; margin-bottom: 1.5rem; color: #1a1a1a;"
                    >
                        How It Works
                    </h3>

                    <div
                        style="background: #f9fafb; border: 1px solid #e5e7eb; border-radius: 12px; padding: 2rem; margin-bottom: 2rem;"
                    >
                        <ol
                            style="list-style-position: inside; color: #4b5563; line-height: 2; font-size: 1.125rem;"
                        >
                            <li style="margin-bottom: 1rem;">
                                <strong style="color: #1a1a1a;"
                                    >Pull Container Image:</strong
                                > ConScan retrieves your container image from any
                                registry (Docker Hub, ECR, GCR, ACR).
                            </li>
                            <li style="margin-bottom: 1rem;">
                                <strong style="color: #1a1a1a;"
                                    >Deep Analysis:</strong
                                > Multiple scanning engines analyze layers, packages,
                                files, and configurations simultaneously.
                            </li>
                            <li style="margin-bottom: 1rem;">
                                <strong style="color: #1a1a1a;"
                                    >Generate Reports:</strong
                                > Receive detailed reports with severity ratings,
                                remediation guidance, and compliance status.
                            </li>
                            <li>
                                <strong style="color: #1a1a1a;"
                                    >Integrate & Automate:</strong
                                > Seamlessly integrate into CI/CD pipelines to automate
                                security checks before deployment.
                            </li>
                        </ol>
                    </div>

                    <h3
                        style="font-size: 2rem; margin-bottom: 1.5rem; color: #1a1a1a;"
                    >
                        Use Cases
                    </h3>
                    <div
                        style="color: #6b7280; line-height: 1.8; font-size: 1.125rem; margin-bottom: 1rem;"
                    >
                        <p style="margin-bottom: 1rem;">
                            <strong style="color: #1a1a1a;"
                                >DevOps Teams:</strong
                            > Shift security left by scanning images during development
                            and preventing vulnerable containers from reaching production.
                        </p>
                        <p style="margin-bottom: 1rem;">
                            <strong style="color: #1a1a1a;"
                                >Security Teams:</strong
                            > Maintain continuous visibility into container security
                            posture across all environments and enforce security
                            policies.
                        </p>
                        <p style="margin-bottom: 1rem;">
                            <strong style="color: #1a1a1a;"
                                >Compliance Officers:</strong
                            > Ensure adherence to industry standards and regulatory
                            requirements with automated compliance reporting.
                        </p>
                    </div>

                    <div style="text-align: center; margin-top: 3rem;">
                        <a
                            href="mailto:contact@peek8.com?subject=ConScan Demo Request"
                            class="btn btn-primary">Request a Demo</a
                        >
                    </div>
                </div>
            </div>
        </section>
    </div>
</div>
