    </div>
    <div class="architecture-flow">
      <div class="flow-container">
        <div class="flow-node alloy">
          <span class="icon">📡</span>
          <span class="label">Grafana Alloy</span>
          <span class="desc">Collects logs from pods</span>
        </div>
        <span class="flow-arrow">→</span>
        <div class="flow-node loki">
          <span class="icon">💾</span>
          <span class="label">Loki</span>
          <span class="desc">Stores & indexes logs</span>
        </div>
        <span class="flow-arrow">→</span>
        <div class="flow-node grafana">
          <span class="icon">📊</span>
          <span class="label">Grafana</span>
          <span class="desc">Visualize & query</span>
        </div>
      </div>
    </div>
    <div class="table-container" style="max-width: 600px; margin: 0 auto;">
      <table>
        <thead>
          <tr>
            <th>Component</th>
            <th>Deployment Model</th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <td style="font-weight: 500;">Grafana Alloy</td>
            <td style="color: var(--slate-600);">DaemonSet on all nodes</td>
          </tr>
          <tr>
            <td style="font-weight: 500;">Loki</td>
            <td style="color: var(--slate-600);">StatefulSet with PVCs</td>
          </tr>
          <tr>
            <td style="font-weight: 500;">Grafana</td>
            <td style="color: var(--slate-600);">Deployment with provisioning</td>
          </tr>
          <tr>
            <td style="font-weight: 500;">Dashboard</td>
            <td style="color: var(--slate-600);">Managed dynamically by operator</td>
          </tr>
          <tr>
            <td style="font-weight: 500;">Datasource</td>
            <td style="color: var(--slate-600);">Managed dynamically by operator</td>
          </tr>
        </tbody>
      </table>
    </div>
  </section>

  <!-- Quick Start -->
  <section id="quickstart">
    <div class="section-header">
      <span class="section-badge">Quick Start</span>
      <h2>Get Started in Minutes</h2>
      <p class="section-desc">Three simple steps to complete log aggregation.</p>
    </div>
    <div class="steps">
      <div class="step">
        <div class="step-number">1</div>
        <div class="step-content">
          <h3>Install the Operator</h3>
          <p>Deploy Bifrost to your Kubernetes cluster.</p>
          <div class="step-code">
            <code>kubectl apply -f https://raw.githubusercontent.com/peek8/bifrost/main/deploy/install.yaml</code>
          </div>
        </div>
      </div>
      <div class="step">
        <div class="step-number">2</div>
        <div class="step-content">
          <h3>Create a LogPipeline</h3>
          <p>Define your logging configuration with a simple CRD.</p>
          <div class="step-code">
            <code>apiVersion: bifrost.peek8.io/v1alpha1
kind: LogPipeline
metadata:
  name: my-logs
  namespace: bifrost-system
spec:
  loki:
    mode: simple
  grafana:
    enabled: true</code>
          </div>
        </div>
      </div>
      <div class="step">
        <div class="step-number">3</div>
        <div class="step-content">
          <h3>Access Grafana</h3>
          <p>Port-forward and start exploring your logs.</p>
          <div class="step-code">
            <code>kubectl port-forward svc/grafana 3000:3000 -n bifrost-system
# Open http://localhost:3000 (admin/admin)</code>
          </div>
        </div>
      </div>
    </div>
  </section>

