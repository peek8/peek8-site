<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Bifrost — Zero-Effort Kubernetes Log Aggregation</title>
  <meta name="description" content="Bifrost is a Kubernetes Operator that automatically deploys Grafana Alloy, Loki, and Grafana for complete log aggregation with no manual setup.">
  <meta name="author" content="peek8">
  <meta name="keywords" content="Kubernetes, Operator, Logs, Grafana, Loki, Alloy, Observability, DevOps, Cloud Native">
  <link rel="icon" type="image/png" href="/favicon.png" />
  <link rel="canonical" href="https://github.com/peek8/bifrost">
  <meta property="og:title" content="Bifrost — Zero-Effort Kubernetes Log Aggregation">
  <meta property="og:description" content="Automatically deploy a complete observability stack — Grafana Alloy → Loki → Grafana — with a single CRD.">
  <meta property="og:type" content="website">
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="Bifrost — Zero-Effort Kubernetes Log Aggregation">
  <meta name="twitter:description" content="Kubernetes Operator for automatic log aggregation with Grafana Alloy, Loki, and Grafana.">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    
    :root {
      --bifrost-violet: #8b5cf6;
      --bifrost-indigo: #6366f1;
      --bifrost-blue: #3b82f6;
      --bifrost-cyan: #06b6d4;
      --bifrost-teal: #14b8a6;
      --slate-50: #f8fafc;
      --slate-100: #f1f5f9;
      --slate-200: #e2e8f0;
      --slate-300: #cbd5e1;
      --slate-400: #94a3b8;
      --slate-500: #64748b;
      --slate-600: #475569;
      --slate-700: #334155;
      --slate-800: #1e293b;
      --slate-900: #0f172a;

      --emerald-50: #ecfdf5;
      --emerald-100: #d1fae5;
      --emerald-200: #a7f3d0;
      --emerald-300: #6ee7b7;
      --emerald-400: #34d399;
      --emerald-500: #10b981;
      --emerald-600: #059669;
      --emerald-700: #047857;
      --teal-50: #f0fdfa;
      --teal-100: #ccfbf1;
      --teal-400: #2dd4bf;
      --teal-500: #14b8a6;
      --teal-600: #0d9488;
      --cyan-50: #ecfeff;
      --cyan-400: #22d3ee;
      --cyan-500: #06b6d4;
    }
    
    body {
      font-family: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, sans-serif;
      background: linear-gradient(135deg, var(--slate-50) 0%, #f0f4ff 50%, #faf5ff 100%);
      color: var(--slate-700);
      line-height: 1.6;
      min-height: 100vh;
    }
    
    .mono { font-family: 'JetBrains Mono', monospace; }
    
    /* Navigation */
    nav {
      position: sticky;
      top: 0;
      z-index: 50;
      background: rgba(255, 255, 255, 0.8);
      backdrop-filter: blur(12px);
      border-bottom: 1px solid var(--slate-200);
    }
    
    .nav-container {
      max-width: 1200px;
      margin: 0 auto;
      padding: 1rem 1.5rem;
      display: flex;
      justify-content: space-between;
      align-items: center;
    }
    
    .logo {
      display: flex;
      align-items: center;
      gap: 0.75rem;
      text-decoration: none;
    }
    
    .logo-text {
      font-size: 1.5rem;
      font-weight: 700;
      background: linear-gradient(135deg, var(--bifrost-violet), var(--bifrost-blue), var(--bifrost-teal));
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
    }
    
    .nav-links {
      display: flex;
      align-items: center;
      gap: 2rem;
    }
    
    .nav-links a {
      color: var(--slate-600);
      text-decoration: none;
      font-weight: 500;
      transition: color 0.2s;
    }
    
    .nav-links a:hover { color: var(--bifrost-violet); }
    
    .github-btn {
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      padding: 0.5rem 1rem;
      background: var(--slate-900);
      color: white !important;
      border-radius: 0.5rem;
      font-weight: 500;
      transition: background 0.2s;
    }
    
    .github-btn:hover { background: var(--slate-700); }
    
    /* Hero Section */
    .hero {
      max-width: 1200px;
      margin: 0 auto;
      padding: 5rem 1.5rem;
      text-align: center;
    }
    
    .badge {
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      padding: 0.5rem 1rem;
      background: #cceaea54;
      border: 1px solid rgba(139, 92, 246, 0.2);
      border-radius: 9999px;
      font-size: 1.5rem;
      font-weight: 700;
      color: var(--emerald-500);
      margin-bottom: 2rem;
    }
    
    h1 {
      font-size: clamp(2.5rem, 6vw, 4rem);
      font-weight: 800;
      line-height: 1.1;
      margin-bottom: 1.5rem;
    }
    
    .gradient-text {
      background: linear-gradient(135deg, var(--emerald-600), var(--teal-600), var(--cyan-500));
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
    }
    
    .hero-subtitle {
      font-size: 1.25rem;
      color: var(--slate-600);
      max-width: 700px;
      margin: 0 auto 2.5rem;
    }
    
    .hero-buttons {
      display: flex;
      justify-content: center;
      gap: 1rem;
      flex-wrap: wrap;
      margin-bottom: 3rem;
    }
    
    .btn {
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      padding: 0.875rem 1.75rem;
      border-radius: 0.75rem;
      font-weight: 600;
      text-decoration: none;
      transition: all 0.2s;
      border: none;
      cursor: pointer;
    }
    
    .btn-primary {
      /*background: linear-gradient(135deg, var(--bifrost-violet), var(--bifrost-blue));*/
      background: linear-gradient(135deg, var(--emerald-500), var(--teal-500));
      color: white;
      box-shadow: 0 4px 20px rgba(139, 92, 246, 0.3);
    }
    
    .btn-primary:hover {
      transform: translateY(-2px);
      box-shadow: 0 6px 30px rgba(139, 92, 246, 0.4);
    }
    
    .btn-secondary {
      background: white;
      color: var(--slate-700);
      border: 1px solid var(--slate-200);
    }
    
    .btn-secondary:hover {
      background: var(--slate-50);
      border-color: var(--slate-300);
    }
    
    /* Code Block */
    .code-block {
      background: var(--slate-900);
      border-radius: 0.75rem;
      overflow: hidden;
      max-width: 600px;
      margin: 0 auto;
      text-align: left;
    }
    
    .code-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 0.75rem 1rem;
      background: var(--slate-800);
      border-bottom: 1px solid var(--slate-700);
    }
    
    .code-header span {
      font-size: 0.75rem;
      color: var(--slate-400);
      font-weight: 500;
    }
    
    .copy-btn {
      background: transparent;
      border: none;
      color: var(--slate-400);
      cursor: pointer;
      padding: 0.25rem;
      transition: color 0.2s;
    }
    
    .copy-btn:hover { color: white; }
    
    .code-content {
      padding: 1rem;
      overflow-x: auto;
    }
    
    .code-content code {
      font-family: 'JetBrains Mono', monospace;
      font-size: 0.875rem;
      color: #e2e8f0;
    }
    
    .code-content .comment { color: #64748b; }
    .code-content .command { color: #a5f3fc; }
    
    /* Sections */
    section {
      max-width: 1200px;
      margin: 0 auto;
      padding: 5rem 1.5rem;
    }
    
    .section-header {
      text-align: center;
      margin-bottom: 3rem;
    }
    
    .section-badge {
      display: inline-block;
      padding: 0.25rem 0.75rem;
      background: #59e5df2e;
      color: var(--emerald-600);
      border-radius: 9999px;
      font-size: 0.75rem;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.05em;
      margin-bottom: 1rem;
    }
    
    h2 {
      font-size: 2.25rem;
      font-weight: 700;
      color: var(--slate-800);
      margin-bottom: 1rem;
    }
    
    .section-desc {
      color: var(--slate-600);
      font-size: 1.125rem;
      max-width: 600px;
      margin: 0 auto;
    }
    
    /* Comparison */
    .comparison-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
      gap: 2rem;
    }
    
    .comparison-card {
      background: white;
      border-radius: 1rem;
      padding: 2rem;
      border: 1px solid var(--slate-200);
    }
    
    .comparison-card.old {
      opacity: 0.7;
    }
    
    .comparison-card.new {
      border-color: rgba(139, 92, 246, 0.3);
      box-shadow: 0 4px 20px rgba(139, 92, 246, 0.1);
    }
    
    .comparison-card h3 {
      font-size: 1.25rem;
      font-weight: 600;
      margin-bottom: 1.5rem;
      display: flex;
      align-items: center;
      gap: 0.5rem;
    }
    
    .comparison-card ul {
      list-style: none;
    }
    
    .comparison-card li {
      display: flex;
      align-items: flex-start;
      gap: 0.75rem;
      margin-bottom: 0.75rem;
      color: var(--slate-600);
    }
    
    .check { color: var(--bifrost-teal); }
    .x { color: #ef4444; }
    
    /* Features Grid */
    .features-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
      gap: 1.5rem;
    }
    
    .feature-card {
      background: white;
      border-radius: 1rem;
      padding: 1.5rem;
      border: 1px solid var(--slate-200);
      transition: all 0.3s;
    }
    
    .feature-card:hover {
      transform: translateY(-4px);
      box-shadow: 0 12px 40px rgba(0, 0, 0, 0.1);
      border-color: rgba(139, 92, 246, 0.3);
    }
    
    .feature-icon {
      width: 3rem;
      height: 3rem;
      border-radius: 0.75rem;
      display: flex;
      align-items: center;
      justify-content: center;
      margin-bottom: 1rem;
      font-size: 1.25rem;
    }
    
    .feature-icon.violet { background: rgba(139, 92, 246, 0.1); color: var(--bifrost-violet); }
    .feature-icon.blue { background: rgba(59, 130, 246, 0.1); color: var(--bifrost-blue); }
    .feature-icon.cyan { background: rgba(6, 182, 212, 0.1); color: var(--bifrost-cyan); }
    .feature-icon.teal { background: rgba(20, 184, 166, 0.1); color: var(--bifrost-teal); }
    .feature-icon.indigo { background: rgba(99, 102, 241, 0.1); color: var(--bifrost-indigo); }
    
    .feature-card h3 {
      font-size: 1.125rem;
      font-weight: 600;
      color: var(--slate-800);
      margin-bottom: 0.5rem;
    }
    
    .feature-card p {
      color: var(--slate-600);
      font-size: 0.875rem;
    }
    
    /* Architecture */
    .architecture-flow {
      background: white;
      border-radius: 1rem;
      padding: 2rem;
      border: 1px solid var(--slate-200);
      margin-bottom: 2rem;
    }
    
    .flow-container {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 1rem;
      flex-wrap: wrap;
    }
    
    .flow-node {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 0.5rem;
      padding: 1rem 1.5rem;
      border-radius: 0.75rem;
      text-align: center;
    }
    
    .flow-node.alloy { background: rgba(139, 92, 246, 0.1); border: 1px solid rgba(139, 92, 246, 0.2); }
    .flow-node.loki { background: rgba(59, 130, 246, 0.1); border: 1px solid rgba(59, 130, 246, 0.2); }
    .flow-node.grafana { background: rgba(20, 184, 166, 0.1); border: 1px solid rgba(20, 184, 166, 0.2); }
    
    .flow-node .icon { font-size: 1.5rem; }
    .flow-node .label { font-weight: 600; color: var(--slate-700); }
    .flow-node .desc { font-size: 0.75rem; color: var(--slate-500); }
    
    .flow-arrow {
      color: var(--slate-400);
      font-size: 1.5rem;
    }
    
    /* Table */
    .table-container {
      background: white;
      border-radius: 1rem;
      overflow: hidden;
      border: 1px solid var(--slate-200);
    }
    
    table {
      width: 100%;
      border-collapse: collapse;
    }
    
    th {
      background: var(--slate-50);
      padding: 1rem;
      text-align: left;
      font-weight: 600;
      color: var(--slate-700);
      border-bottom: 1px solid var(--slate-200);
    }
    
    td {
      padding: 1rem;
      border-bottom: 1px solid var(--slate-100);
    }
    
    tr:last-child td { border-bottom: none; }
    
    .mode-badge {
      display: inline-block;
      padding: 0.25rem 0.5rem;
      border-radius: 0.375rem;
      font-size: 0.75rem;
      font-weight: 600;
    }
    
    .mode-badge.simple { background: rgba(139, 92, 246, 0.1); color: var(--bifrost-violet); }
    .mode-badge.scalable { background: rgba(59, 130, 246, 0.1); color: var(--bifrost-blue); }
    
    /* Quick Start */
    .steps {
      display: flex;
      flex-direction: column;
      gap: 2rem;
    }
    
    .step {
      display: flex;
      gap: 1.5rem;
    }
    
    .step-number {
      width: 2.5rem;
      height: 2.5rem;
      background: linear-gradient(135deg, var(--bifrost-violet), var(--bifrost-blue));
      color: white;
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      font-weight: 700;
      flex-shrink: 0;
    }
    
    .step-content {
      flex: 1;
    }
    
    .step-content h3 {
      font-size: 1.125rem;
      font-weight: 600;
      color: var(--slate-800);
      margin-bottom: 0.5rem;
    }
    
    .step-content p {
      color: var(--slate-600);
      margin-bottom: 1rem;
    }
    
    .step-code {
      background: var(--slate-900);
      border-radius: 0.5rem;
      padding: 1rem;
      overflow-x: auto;
    }
    
    .step-code code {
      font-family: 'JetBrains Mono', monospace;
      font-size: 0.8rem;
      color: #e2e8f0;
      white-space: pre;
    }
    
    /* Roadmap */
    .roadmap-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
      gap: 1rem;
    }
    
    .roadmap-item {
      display: flex;
      align-items: center;
      gap: 0.75rem;
      padding: 1rem;
      background: white;
      border-radius: 0.75rem;
      border: 1px solid var(--slate-200);
    }
    
    .roadmap-item .icon {
      color: var(--bifrost-cyan);
    }
    
    /* CTA */
    .cta {
      background: linear-gradient(135deg, rgba(139, 92, 246, 0.05), rgba(59, 130, 246, 0.05), rgba(6, 182, 212, 0.05));
      border-radius: 1.5rem;
      padding: 4rem 2rem;
      text-align: center;
      border: 1px solid rgba(139, 92, 246, 0.1);
    }
    
    .cta h2 {
      font-size: 2rem;
      margin-bottom: 1rem;
    }
    
    .cta p {
      color: var(--slate-600);
      margin-bottom: 2rem;
      max-width: 500px;
      margin-left: auto;
      margin-right: auto;
    }
    
    /* Footer */
    footer {
      border-top: 1px solid var(--slate-200);
      padding: 2rem 1.5rem;
      text-align: center;
    }
    
    .footer-content {
      max-width: 1200px;
      margin: 0 auto;
      display: flex;
      justify-content: space-between;
      align-items: center;
      flex-wrap: wrap;
      gap: 1rem;
    }
    
    .footer-links {
      display: flex;
      gap: 2rem;
    }
    
    .footer-links a {
      color: var(--slate-500);
      text-decoration: none;
      font-size: 0.875rem;
      transition: color 0.2s;
    }
    
    .footer-links a:hover { color: var(--bifrost-violet); }
    
    .footer-copy {
      color: var(--slate-500);
      font-size: 0.875rem;
    }
    
    /* Icons (inline SVG replacements) */
    .icon-svg {
      width: 1.25rem;
      height: 1.25rem;
    }
    
    /* Responsive */
    @media (max-width: 768px) {
      .nav-links { display: none; }
      .hero { padding: 3rem 1rem; }
      h1 { font-size: 2rem; }
      .comparison-grid { grid-template-columns: 1fr; }
      .flow-container { flex-direction: column; }
      .flow-arrow { transform: rotate(90deg); }
      .step { flex-direction: column; gap: 1rem; }
      .footer-content { flex-direction: column; text-align: center; }
    }
  </style>
</head>
<body>
  <!-- Navigation -->
  <nav>
    <div class="nav-container">
      <a href="/"><img src="/logo.png" width="100px"></a>
      <div class="nav-links">
        <a href="/">Home</a>
        <a href="#features">Features</a>
        <a href="#architecture">Architecture</a>
        <a href="#quickstart">Quick Start</a>
        <a href="https://github.com/peek8/bifrost" class="github-btn" target="_blank" rel="noopener">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z"/></svg>
          GitHub
        </a>
      </div>
    </div>
  </nav>

  <!-- Hero Section -->
  <header class="hero">
    <div class="badge">
      <span>🌈</span>
      <span>Bifrost</span>
    </div>
    <h1>
      <span class="gradient-text">Zero-Effort</span><br>
      Kubernetes Log Aggregation
    </h1>
    <p class="hero-subtitle">
      Bifrost is a Kubernetes Operator that automatically deploys Grafana Alloy, Loki, and Grafana for complete log aggregation — with no manual configuration required.
    </p>
    <div class="hero-buttons">
      <a href="#quickstart" class="btn btn-primary">
        Get Started
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
      </a>
      <a href="https://github.com/peek8/bifrost" class="btn btn-secondary" target="_blank" rel="noopener">
        <svg width="20" height="20" fill="currentColor" viewBox="0 0 24 24">
