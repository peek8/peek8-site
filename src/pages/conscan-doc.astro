        <!-- Installation -->
        <section id="installation">
            <div class="container">
                <h2 class="section-title">Getting Started</h2>
                <p class="section-subtitle">Multiple installation options to fit your workflow</p>

                <div id="binary-install" style="scroll-margin-top: 100px;">
                    <h3 style="margin-bottom: 1rem; font-size: 2rem; color: #1a1a1a;">Binary Install</h3>
                    <h4>Pre-Requisites</h4>
                    <p class="para-content">
                        If you want to install the binary at your machine, you need to install the following tools to make the binary work:
                        <br>
                        • <a href="https://github.com/aquasecurity/trivy">Trivy</a>  • <a href="https://github.com/anchore/grype">Grype</a>
                        • <a href="https://github.com/anchore/syft">Syft</a>
                        <br>
                         • <a href="https://github.com/wagoodman/dive">Dive</a> • <a href="https://github.com/goodwithtech/dockle">Dockle</a>
                    </p>
                    <p class="para-content">
                        You can go to the corresponding sites and install them as per the installation guide, or can use <a href="https://raw.githubusercontent.com/peek8/conscan/main/scripts/install-dependencies.sh">install-dependencies.sh</a> script:
                    </p>
                    <div class="code-block">
                        <pre>
$ curl -sSL https://raw.githubusercontent.com/peek8/conscan/main/scripts/install-dependencies.sh | bash                            
                        </pre>
                    </div>
                    <h4>Binary</h4>
                    <p class="para-content">
                        Get the latest version from the releases page and put it in your $PATH.
                    </p>
                    
                    <div class="code-block">
<span class="comment"># Set version</span>
<span class="prompt">$</span> conscan_version=0.1.0-alpha1

<span class="comment"># Download for macOS ARM64</span>
<span class="prompt">$</span> <span>{`wget -qO- "https://github.com/peek8/conscan/releases/download/v\${conscan_version}/conscan_\${conscan_version}_darwin_arm64.tar.gz" | tar -xz -C /usr/local/bin conscan`}</span>

<span class="comment"># Make executable</span>
<span class="prompt">$</span> chmod +x /usr/local/bin/conscan
                    </div>

                    <p style="color: #6b7280; margin-top: 1rem;">
                        Check your OS with <code>uname -s</code> and architecture with <code>uname -m</code> to download the correct version.
                    </p>
                </div>

                <div id="docker-install" style="margin-top: 4rem; scroll-margin-top: 100px;">
                    <h3 style="margin-bottom: 1rem; font-size: 2rem; color: #1a1a1a;">Docker</h3>
                    <p style="color: #6b7280; margin-bottom: 1rem;">Use the ConScan container image without installing dependencies.</p>
                    
                    <div class="code-block">
<span class="comment"># Basic usage</span>
<!-- <span class="prompt">$</span> -->
<pre>
$ docker run --rm -it \
--name conscan ghcr.io/peek8/conscan:latest \
scan alpine:latest
</pre>
<span class="comment"># With persistent cache (recommended)</span>
<!-- <span class="prompt">$</span>  -->
<pre>
$ docker run --rm -it \
  -v ./cache:/.cache \
  --name conscan ghcr.io/peek8/conscan:latest \
  scan alpine:latest
</pre>  
                    </div>

                    <p style="color: #6b7280; margin-top: 1rem;">
                        Mounting a cache directory persists vulnerability databases between scans for faster performance.
                    </p>
                </div>
            </div>
        </section>

