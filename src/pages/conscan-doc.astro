        <section class="section-light" id="usage">
            <div class="container">
                <h2 class="section-title">Usage Guide</h2>
                <p class="section-subtitle">Simple commands for comprehensive scanning</p>

                <h3 style="margin: 2rem 0 1rem;">Basic Scanning</h3>
                <div class="code-block">
<span class="comment"># Scan a local image</span>
<span class="prompt">$</span> conscan scan alpine-sec:1.0

