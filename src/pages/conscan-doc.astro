                    </div>

                    <div class="format-card">
                        <h4>JSON Format</h4>
                        <ul>
                            <li>CI/CD integration</li>
                            <li>Automation-ready</li>
                            <li>Machine-parseable</li>
                        </ul>
                        <div class="code-block" style="margin-top: 1rem;">
<span class="prompt">$</span> conscan scan --format json 
--output report.json yourimage:tag
                        </div>
                    </div>
                </div>
            </div>
