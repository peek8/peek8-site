    <!-- Quick Start Section -->
    <section id="quickstart" class="quickstart">
      <div class="container">
        <div class="section-header">
          <p class="section-label">Quick Start</p>
          <h2 class="section-title">Get Started in Minutes</h2>
          <p class="section-desc">
            Start scanning your container images with just a few commands.
          </p>
        </div>
        <div class="steps-container">
          <div class="step">
            <div class="step-number">1</div>
            <div class="step-content">
              <h3>Run with Docker (Recommended)</h3>
              <p>No installation required. Just run the container directly.</p>
              <div class="step-code">
                <code
                  ><span class="comment"># Scan any container image</span>
                  $ docker run --rm -it ghcr.io/peek8/conscan:latest scan alpine:latest</code
                >
              </div>
            </div>
          </div>
          <div class="step">
            <div class="step-number">2</div>
            <div class="step-content">
              <h3>Or Install Binary</h3>
              <p>Download the binary for your OS and install dependencies.</p>
              <div class="step-code">
                <code
                  ><span class="comment"
                    ># Download and install (example for macOS ARM64)</span
                  >
                  $ conscan_version=v0.1.5 wget -qO- {
                    "https://github.com/peek8/conscan/releases/download/v${conscan_version}/conscan_${conscan_version}_darwin_arm64.tar.gz"
                  } | tar -xz -C /usr/local/bin conscan</code
                >
              </div>
            </div>
          </div>
          <div class="step">
            <div class="step-number">3</div>
            <div class="step-content">
              <h3>Scan Your Images</h3>
              <p>Run scans with custom options and output formats.</p>
              <div class="step-code">
                <code
                  ><span class="comment"># Full scan with HTML report</span>
                  $ conscan scan --format html --output report.html yourimage:tag

                  <span class="comment"># Scan specific categories only</span>
                  $ conscan scan --scanners=vuln,secret yourimage:tag</code
                >
              </div>
            </div>
          </div>
          <div class="step">
            <div class="step-number">4</div>
            <div class="step-content">
              <h3>Integrate with CI/CD</h3>
              <p>
                Add Conscan to your GitHub Actions workflow for automated
                scanning.
              </p>
              <div class="step-code">
                <code
                  ><span class="comment"># In your GitHub Actions workflow</span
                  >
                  - run: | docker run --rm ghcr.io/peek8/conscan:latest \ scan {
                    "${{ env.IMAGE_NAME }}:${{ env.IMAGE_TAG }}"
                  }</code
                >
              </div>
              <p style="margin-top:12px;">
                For more details, See the "scan" Job and "update-index" Job at
                the
                <a
                  href="https://github.com/peek8/conscan-sample/blob/main/.github/workflows/build.yaml#L63-L111"
                  target="_blank"
                  >github action workflows at conscan-sample repo</a
                >.
              </p>
            </div>
          </div>
        </div>
      </div>
    </section>

