        max-width: 520px;
        margin: 0 auto 24px;
        font-size: 1rem;
      }

      .btn-premium {
        display: inline-flex;
        align-items: center;
        gap: 10px;
        background: linear-gradient(135deg, #f59e0b, #d97706);
