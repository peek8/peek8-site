        font-size: 1.1rem;
        font-weight: 700;
        color: var(--slate-800);
        margin-bottom: 8px;
      }
      .ai-feature-card p {
        font-size: 0.9rem;
        color: var(--slate-500);
        line-height: 1.6;
      }

      /* CTA Section */
      .cta {
        padding: 100px 0;
        text-align: center;
        background: linear-gradient(
          135deg,
          var(--emerald-50),
          var(--teal-50),
          var(--cyan-50)
