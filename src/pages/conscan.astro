        font-size: clamp(2rem, 4vw, 2.75rem);
        font-weight: 800;
        color: var(--slate-800);
        margin-bottom: 16px;
      }

      .cta p {
        font-size: 1.125rem;
        color: var(--slate-600);
        margin-bottom: 32px;
        max-width: 600px;
        margin-left: auto;
        margin-right: auto;
      }

      /* Footer */
