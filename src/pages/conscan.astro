---
import Footer from "../components/Footer.astro";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Conscan - Secure, Lean, and Compliant Containers Made Simple</title>
    <meta
      name="description"
      content="Conscan scans container images for vulnerabilities, exposed secrets, inefficient storage, SBOM generation, and CIS Benchmark checks. One command, complete security."
    />
    <meta
      name="keywords"
      content="container security, vulnerability scanner, SBOM, secrets detection, CIS benchmarks, Docker, container image scanner"
    />
    <meta property="og:title" content="Conscan - Container Security Scanner" />
    <meta
      property="og:description"
      content="Secure, lean, and compliant containers made simple. Scan for vulnerabilities, secrets, SBOM, and CIS compliance."
    />
    <meta property="og:type" content="website" />
    <link rel="icon" type="image/png" href="/favicon.png" />

    <link rel="stylesheet" href="/css/fonts.css" />

    <style>
      :root {
        --emerald-50: #ecfdf5;
        --emerald-100: #d1fae5;
        --emerald-200: #a7f3d0;
        --emerald-300: #6ee7b7;
        --emerald-400: #34d399;
        --emerald-500: #10b981;
        --emerald-600: #059669;
        --emerald-700: #047857;

        --teal-50: #f0fdfa;
        --teal-100: #ccfbf1;
        --teal-400: #2dd4bf;
        --teal-500: #14b8a6;
        --teal-600: #0d9488;

        --cyan-50: #ecfeff;
        --cyan-400: #22d3ee;
        --cyan-500: #06b6d4;

        --slate-50: #f8fafc;
        --slate-100: #f1f5f9;
        --slate-200: #e2e8f0;
        --slate-300: #cbd5e1;
        --slate-400: #94a3b8;
        --slate-500: #64748b;
        --slate-600: #475569;
        --slate-700: #334155;
        --slate-800: #1e293b;
        --slate-900: #0f172a;

        --red-500: #ef4444;
        --red-600: #dc2626;
        --orange-500: #f97316;
        --yellow-500: #eab308;
      }

      * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
      }

      body {
        font-family:
          "Plus Jakarta Sans",
          -apple-system,
          BlinkMacSystemFont,
          sans-serif;
        /* background: linear-gradient(180deg, var(--emerald-50) 0%, #ffffff 30%, #ffffff 70%, var(--teal-50) 100%); */
        color: var(--slate-800);
        line-height: 1.6;
        min-height: 100vh;
      }

      .container {
        max-width: 1200px;
        margin: 0 auto;
        padding: 0 24px;
      }

      /* Navigation */
      nav {
        position: fixed;
        top: 0;
        left: 0;
        right: 0;
        z-index: 100;
        background: rgba(255, 255, 255, 0.9);
        backdrop-filter: blur(12px);
        border-bottom: 1px solid var(--emerald-100);
      }

      .nav-content {
        max-width: 1200px;
        margin: 0 auto;
        padding: 16px 24px;
        display: flex;
        justify-content: space-between;
        align-items: center;
      }

      .nav-brand {
        display: flex;
        align-items: center;
        gap: 12px;
        text-decoration: none;
        font-weight: 700;
        font-size: 1.5rem;
        color: var(--slate-800);
      }

      .nav-brand svg {
        width: 40px;
        height: 40px;
      }

      .nav-links {
        display: flex;
        align-items: center;
        gap: 32px;
      }

      .nav-links a {
        text-decoration: none;
        color: var(--slate-600);
        font-weight: 500;
        font-size: 0.95rem;
        transition: color 0.2s;
      }

      .nav-links a:hover {
        color: var(--emerald-600);
      }

      .nav-github {
        display: flex;
        align-items: center;
        gap: 8px;
        background: var(--slate-800);
        color: white !important;
        padding: 10px 20px;
        border-radius: 8px;
        transition:
          background 0.2s,
          transform 0.2s;
      }

      .nav-github:hover {
        background: var(--slate-700);
        transform: translateY(-1px);
      }

      /* Hero Section */
      .hero {
        padding: 160px 0 100px;
        text-align: center;
        position: relative;
        overflow: hidden;
      }

      .hero::before {
        content: "";
        position: absolute;
        top: 0;
        left: 50%;
        transform: translateX(-50%);
        width: 800px;
        height: 800px;
        /* background: radial-gradient(circle, var(--emerald-100) 0%, transparent 70%); */
        opacity: 0.6;
        pointer-events: none;
      }

      .hero-badge {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        background: #c6eeee26;
        border: 1px solid #d1f1f4;
        padding: 8px 16px;
        border-radius: 50px;
        font-size: 1.2rem;
        font-weight: 800;
        color: var(--emerald-700);
        margin-bottom: 24px;
      }

      .hero h1 {
        font-size: clamp(2.5rem, 6vw, 4rem);
        font-weight: 800;
        line-height: 1.1;
        margin-bottom: 24px;
        background: linear-gradient(
          135deg,
          var(--emerald-600),
          var(--teal-600),
          var(--cyan-500)
        );
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
      }

      .hero-subtitle {
        font-size: 1.25rem;
        color: var(--slate-600);
        max-width: 700px;
        margin: 0 auto 40px;
      }

      .hero-buttons {
        display: flex;
        gap: 16px;
        justify-content: center;
        flex-wrap: wrap;
        margin-bottom: 48px;
      }

      .btn-primary {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        background: linear-gradient(
          135deg,
          var(--emerald-500),
          var(--teal-500)
        );
        color: white;
        padding: 14px 28px;
        border-radius: 10px;
        text-decoration: none;
        font-weight: 600;
        font-size: 1rem;
        transition:
          transform 0.2s,
          box-shadow 0.2s;
        box-shadow: 0 4px 20px rgba(16, 185, 129, 0.3);
      }

      .btn-primary:hover {
        transform: translateY(-2px);
        box-shadow: 0 8px 30px rgba(16, 185, 129, 0.4);
      }

      .btn-secondary {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        background: white;
        color: var(--slate-700);
        padding: 14px 28px;
        border-radius: 10px;
        text-decoration: none;
        font-weight: 600;
        font-size: 1rem;
        border: 2px solid var(--slate-200);
        transition: all 0.2s;
      }

      .btn-secondary:hover {
        border-color: var(--emerald-300);
        background: var(--emerald-50);
      }

      /* Code Block */
      .code-block {
        background: var(--slate-800);
        border-radius: 12px;
        padding: 20px 24px;
        max-width: 600px;
        margin: 0 auto;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 16px;
        box-shadow: 0 10px 40px rgba(0, 0, 0, 0.15);
      }

      .code-block code {
        font-family: "JetBrains Mono", monospace;
        color: var(--emerald-300);
        font-size: 0.9rem;
      }

      .code-block .prefix {
        color: var(--slate-400);
      }

      .copy-btn {
        background: var(--slate-700);
        border: none;
        color: var(--slate-300);
        padding: 8px 12px;
        border-radius: 6px;
        cursor: pointer;
        transition: all 0.2s;
        display: flex;
        align-items: center;
        gap: 6px;
        font-family: inherit;
        font-size: 0.8rem;
      }

      .copy-btn:hover {
        background: var(--slate-600);
        color: white;
      }

      /* Features Section */
      .features {
        padding: 100px 0;
      }

      .section-header {
        text-align: center;
        margin-bottom: 60px;
      }

      .section-label {
        font-size: 0.875rem;
        font-weight: 600;
        color: var(--emerald-600);
        text-transform: uppercase;
        letter-spacing: 0.1em;
        margin-bottom: 12px;
      }

      .section-title {
        font-size: clamp(2rem, 4vw, 2.75rem);
        font-weight: 800;
        color: var(--slate-800);
        margin-bottom: 16px;
      }

      .section-desc {
        font-size: 1.125rem;
        color: var(--slate-500);
        max-width: 600px;
        margin: 0 auto;
      }

      .features-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
        gap: 24px;
      }

      .feature-card {
        background: white;
        border: 1px solid var(--emerald-100);
        border-radius: 16px;
        padding: 32px;
        transition: all 0.3s;
        position: relative;
        overflow: hidden;
      }

      .feature-card::before {
        content: "";
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        height: 4px;
        background: linear-gradient(90deg, var(--emerald-400), var(--teal-400));
        opacity: 0;
        transition: opacity 0.3s;
      }

      .feature-card:hover {
        transform: translateY(-4px);
        box-shadow: 0 20px 40px rgba(16, 185, 129, 0.1);
        border-color: var(--emerald-200);
      }

      .feature-card:hover::before {
        opacity: 1;
      }

      .feature-icon {
        width: 56px;
        height: 56px;
        background: linear-gradient(
          135deg,
          var(--emerald-100),
          var(--teal-100)
        );
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        margin-bottom: 20px;
        font-size: 1.75rem;
      }

      .feature-card h3 {
        font-size: 1.25rem;
        font-weight: 700;
        color: var(--slate-800);
        margin-bottom: 12px;
      }

      .feature-card p {
        color: var(--slate-500);
        font-size: 0.95rem;
        line-height: 1.7;
      }

      /* Powered By Section */
      .powered-by {
        padding: 80px 0;
        background: linear-gradient(180deg, white, var(--emerald-50));
      }

      .tools-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
        gap: 24px;
        margin-top: 48px;
      }

      .tool-card {
        background: white;
        border: 1px solid var(--slate-200);
        border-radius: 12px;
        padding: 24px;
        text-align: center;
        transition: all 0.3s;
      }

      .tool-card:hover {
        border-color: var(--emerald-300);
        box-shadow: 0 10px 30px rgba(16, 185, 129, 0.1);
      }

      .tool-card h4 {
        font-size: 1.125rem;
        font-weight: 700;
        color: var(--slate-800);
        margin-bottom: 8px;
      }

      .tool-card p {
        font-size: 0.875rem;
        color: var(--slate-500);
      }

      /* Architecture Section */
      .architecture {
        padding: 100px 0;
      }

      .arch-flow {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 16px;
        flex-wrap: wrap;
        margin-bottom: 48px;
        padding: 40px;
        background: linear-gradient(135deg, var(--emerald-50), var(--teal-50));
        border-radius: 20px;
        border: 1px solid var(--emerald-100);
      }

      .arch-node {
        background: white;
        border: 2px solid var(--emerald-200);
        border-radius: 12px;
        padding: 20px 32px;
        text-align: center;
        min-width: 140px;
        transition: all 0.3s;
      }

      .arch-node:hover {
        border-color: var(--emerald-400);
        transform: scale(1.05);
        box-shadow: 0 10px 30px rgba(16, 185, 129, 0.15);
      }

      .arch-node .icon {
        font-size: 2rem;
        margin-bottom: 8px;
      }

      .arch-node .label {
        font-weight: 600;
        color: var(--slate-700);
        font-size: 0.95rem;
      }

      .arch-arrow {
        color: var(--emerald-400);
        font-size: 1.5rem;
        font-weight: 700;
      }

      .table-container {
        overflow-x: auto;
        max-width: 700px;
        margin: 0 auto;
      }

      table {
        width: 100%;
        border-collapse: collapse;
        background: white;
        border-radius: 12px;
        overflow: hidden;
        box-shadow: 0 4px 20px rgba(0, 0, 0, 0.05);
      }

      th,
      td {
        padding: 16px 24px;
        text-align: left;
      }

      th {
        background: linear-gradient(
          135deg,
          var(--emerald-500),
          var(--teal-500)
        );
        color: white;
        font-weight: 600;
        font-size: 0.9rem;
      }

      td {
        border-bottom: 1px solid var(--slate-100);
        font-size: 0.95rem;
      }

      tr:last-child td {
        border-bottom: none;
      }

      tr:hover td {
        background: var(--emerald-50);
      }

      /* Quick Start Section */
      .quickstart {
        padding: 100px 0;
        background: linear-gradient(180deg, var(--teal-50), white);
      }

      .steps-container {
        display: flex;
        flex-direction: column;
        gap: 32px;
        max-width: 800px;
        margin: 0 auto;
      }

      .step {
        display: flex;
        gap: 24px;
        align-items: flex-start;
      }

      .step-number {
        width: 48px;
        height: 48px;
        background: linear-gradient(
          135deg,
          var(--emerald-500),
          var(--teal-500)
        );
        color: white;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: 700;
        font-size: 1.25rem;
        flex-shrink: 0;
      }

      .step-content {
        flex: 1;
      }

      .step-content h3 {
        font-size: 1.25rem;
        font-weight: 700;
        color: var(--slate-800);
        margin-bottom: 8px;
      }

      .step-content p {
        color: var(--slate-500);
        margin-bottom: 16px;
      }

      .step-code {
        background: var(--slate-800);
        border-radius: 10px;
        padding: 16px 20px;
        overflow-x: auto;
      }

      .step-code code {
        font-family: "JetBrains Mono", monospace;
        color: var(--emerald-300);
        font-size: 0.85rem;
        white-space: pre;
      }

      .step-code .comment {
        color: var(--slate-500);
      }

      /* Report Formats Section */
      .reports {
        padding: 100px 0;
      }

      .reports-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 24px;
        margin-top: 48px;
      }

      @media (max-width: 768px) {
        .reports-grid {
          grid-template-columns: 1fr;
        }
      }

      .report-card {
        background: white;
        border: 1px solid var(--slate-200);
        border-radius: 16px;
        padding: 32px;
        text-align: center;
        transition: all 0.3s;
      }

      .report-card:hover {
        border-color: var(--emerald-300);
        transform: translateY(-4px);
        box-shadow: 0 15px 40px rgba(16, 185, 129, 0.1);
      }

      .report-icon {
        font-size: 3rem;
        margin-bottom: 16px;
      }

      .report-card h4 {
        font-size: 1.25rem;
        font-weight: 700;
        color: var(--slate-800);
        margin-bottom: 8px;
      }

      .report-card p {
        color: var(--slate-500);
        font-size: 0.9rem;
      }

      .report-cmd {
        margin-top: 16px;
        background: var(--slate-100);
        border-radius: 8px;
        padding: 10px 16px;
        font-family: "JetBrains Mono", monospace;
        font-size: 0.75rem;
        color: var(--slate-600);
      }

      /* Premium Badge */
      .premium-badge {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        background: linear-gradient(135deg, #f59e0b, #d97706);
        color: white;
        padding: 4px 12px;
        border-radius: 50px;
        font-size: 0.75rem;
        font-weight: 700;
        letter-spacing: 0.05em;
        text-transform: uppercase;
      }

      /* Dashboard Section */
      .dashboard-section {
        padding: 100px 0;
        background: linear-gradient(180deg, var(--teal-50), white);
      }

      .premium-header {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 16px;
        flex-wrap: wrap;
        margin-bottom: 16px;
      }

      .dashboard-preview {
        background: white;
        border: 1px solid var(--emerald-100);
        border-radius: 20px;
        overflow: hidden;
        box-shadow: 0 20px 60px rgba(16, 185, 129, 0.1);
        margin-bottom: 48px;
      }

      .dashboard-topbar {
        background: linear-gradient(135deg, var(--slate-800), var(--slate-700));
        padding: 12px 20px;
        display: flex;
        align-items: center;
        gap: 8px;
      }

      .dot {
        width: 12px;
        height: 12px;
        border-radius: 50%;
      }
      .dot-red {
        background: #ef4444;
      }
      .dot-yellow {
        background: #f59e0b;
      }
      .dot-green {
        background: #10b981;
      }

      .dashboard-topbar span {
        color: var(--slate-400);
        font-family: "JetBrains Mono", monospace;
        font-size: 0.8rem;
        margin-left: 8px;
      }

      .dashboard-body {
        display: grid;
        grid-template-columns: 1fr 1fr 1fr 1fr;
        gap: 0;
      }

      @media (max-width: 768px) {
        .dashboard-body {
          grid-template-columns: 1fr 1fr;
        }
      }

      .dash-stat {
        padding: 24px;
        border-right: 1px solid var(--slate-100);
        border-bottom: 1px solid var(--slate-100);
      }

      .dash-stat:last-child {
        border-right: none;
      }

      .dash-stat-label {
        font-size: 0.8rem;
        font-weight: 600;
        color: var(--slate-500);
        text-transform: uppercase;
        letter-spacing: 0.08em;
        margin-bottom: 8px;
      }

      .dash-stat-value {
        font-size: 2rem;
        font-weight: 800;
        line-height: 1;
      }

      .dash-stat-value.critical {
        color: var(--red-600);
      }
      .dash-stat-value.high {
        color: var(--orange-500);
      }
      .dash-stat-value.medium {
        color: var(--yellow-500);
      }
      .dash-stat-value.safe {
        color: var(--emerald-500);
      }

      .dash-stat-sub {
        font-size: 0.8rem;
        color: var(--slate-400);
        margin-top: 4px;
      }

      .dashboard-table-wrap {
        padding: 24px;
        border-top: 1px solid var(--slate-100);
        overflow-x: auto;
      }

      .dashboard-table-wrap table {
        box-shadow: none;
        border: 1px solid var(--slate-100);
      }

      .dashboard-table-wrap th {
        background: var(--slate-100);
        color: var(--slate-700);
        font-size: 0.8rem;
      }

      .status-pill {
        display: inline-block;
        padding: 3px 10px;
        border-radius: 50px;
        font-size: 0.75rem;
        font-weight: 600;
      }

      .status-pill.fail {
        background: #fee2e2;
        color: var(--red-600);
      }
      .status-pill.pass {
        background: var(--emerald-100);
        color: var(--emerald-700);
      }
      .status-pill.warn {
        background: #fef3c7;
        color: #92400e;
      }

      /* Alert Rules Section */
      .alert-rules {
        padding: 100px 0;
        background: white;
      }

      .alert-features-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 32px;
        align-items: center;
        margin-top: 48px;
      }

      @media (max-width: 768px) {
        .alert-features-grid {
          grid-template-columns: 1fr;
        }
      }

      .alert-rule-card {
        background: var(--slate-50);
        border: 1px solid var(--slate-200);
        border-radius: 16px;
        padding: 28px;
      }

      .alert-rule-card h4 {
        font-size: 1rem;
        font-weight: 700;
        color: var(--slate-700);
        margin-bottom: 16px;
        display: flex;
        align-items: center;
        gap: 8px;
      }

      .rule-row {
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 12px 0;
        border-bottom: 1px solid var(--slate-200);
      }

      .rule-row:last-child {
        border-bottom: none;
      }

      .rule-icon {
        font-size: 1.25rem;
        width: 32px;
        text-align: center;
        flex-shrink: 0;
      }

      .rule-content {
        flex: 1;
      }

      .rule-title {
        font-size: 0.875rem;
        font-weight: 600;
        color: var(--slate-700);
      }

      .rule-desc {
        font-size: 0.8rem;
        color: var(--slate-500);
        margin-top: 2px;
      }

      .rule-trigger {
        background: white;
        border: 1px solid var(--emerald-200);
        border-radius: 8px;
        padding: 20px;
        margin-bottom: 16px;
      }

      .rule-trigger-label {
        font-size: 0.75rem;
        font-weight: 600;
        color: var(--slate-500);
        text-transform: uppercase;
        letter-spacing: 0.08em;
        margin-bottom: 8px;
      }

      .rule-trigger-row {
        display: flex;
        align-items: center;
        gap: 8px;
        flex-wrap: wrap;
      }

      .rule-chip {
        background: var(--emerald-100);
        color: var(--emerald-700);
        padding: 4px 12px;
        border-radius: 6px;
        font-size: 0.875rem;
        font-weight: 600;
        font-family: "JetBrains Mono", monospace;
      }

      .rule-chip.critical {
        background: #fee2e2;
        color: var(--red-600);
      }

      .rule-chip.channel {
        background: #ede9fe;
        color: #6d28d9;
      }

      .rule-chip.email {
        background: #dbeafe;
        color: #1d4ed8;
      }

      .rule-connector {
        color: var(--slate-400);
        font-size: 0.8rem;
        font-weight: 600;
      }

      .alert-list {
        display: flex;
        flex-direction: column;
        gap: 16px;
      }

      .alert-list-item {
        background: white;
        border: 1px solid var(--slate-200);
        border-radius: 12px;
        padding: 20px;
        display: flex;
        align-items: flex-start;
        gap: 16px;
        transition: all 0.3s;
      }

      .alert-list-item:hover {
        border-color: var(--emerald-200);
        box-shadow: 0 4px 16px rgba(16, 185, 129, 0.08);
      }

      .alert-channel-icon {
        width: 44px;
        height: 44px;
        border-radius: 10px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.25rem;
        flex-shrink: 0;
      }

      .alert-channel-icon.slack {
        background: #ede9fe;
      }
      .alert-channel-icon.email {
        background: #dbeafe;
      }

      .alert-item-title {
        font-weight: 600;
        color: var(--slate-800);
        font-size: 0.95rem;
      }

      .alert-item-desc {
        font-size: 0.85rem;
        color: var(--slate-500);
