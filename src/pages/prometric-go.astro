                                id="gin-code"><span class="keyword">package</span> <span class="package">main</span>

<span class="keyword">import</span> (
    <span class="string">"time"</span>

    <span class="string">"github.com/gin-gonic/gin"</span>
    <span class="string">"github.com/prometheus/client_golang/prometheus/promhttp"</span>
    <span class="string">"github.com/peek8/prometric-go/prometrics"</span>
)

<span class="keyword">func</span> <span class="function">main</span>() {"{"}
    r := gin.<span class="function">Default</span>()
    r.<span class="function">Use</span>(prometrics.<span class="function">GinMiddleware</span>())
    r.<span class="function">Use</span>(prometrics.<span class="function">GinHealthMiddleware</span>())

    r.<span class="function">GET</span>(<span class="string">"/ping"</span>, <span class="keyword">func</span>(c *gin.Context) {"{"}
        c.<span class="function">JSON</span>(<span class="number">200</span>, gin.H{"{"}<span class="string">"msg"</span>: <span class="string">"pong"</span>{"}"})
    {"}"})

    r.<span class="function">GET</span>(<span class="string">"/person"</span>, <span class="keyword">func</span>(c *gin.Context) {"{"}
        <span class="keyword">defer</span> prometrics.<span class="function">TrackCRUD</span>(<span class="string">"person"</span>, <span class="string">"Get"</span>)(time.<span class="function">Now</span>())
        c.<span class="function">JSON</span>(<span class="number">200</span>, gin.H{"{"}<span class="string">"name"</span>: <span class="string">"asraf"</span>{"}"})
    {"}"})

    r.<span class="function">POST</span>(<span class="string">"/person"</span>, <span class="keyword">func</span>(c *gin.Context) {"{"}
        <span class="keyword">defer</span> prometrics.<span class="function">TrackCRUD</span>(<span class="string">"person"</span>, <span class="string">"create"</span>)(time.<span class="function">Now</span>())
        prometrics.<span class="function">IncObjectCount</span>(<span class="string">"person"</span>)

        time.<span class="function">Sleep</span>(<span class="number">200</span> * time.Millisecond)
        c.<span class="function">JSON</span>(<span class="number">201</span>, gin.H{"{"}<span class="string">"status"</span>: <span class="string">"created"</span>{"}"})
    {"}"})

    r.<span class="function">GET</span>(<span class="string">"/metrics"</span>, gin.<span class="function">WrapH</span>(promhttp.<span class="function">Handler</span>()))
    r.<span class="function">Run</span>(<span class="string">":7080"</span>)
{"}"}</pre>
