                        GitHub
                    </a>
                </div>
            </div>
        </nav>

        <main>
            <!-- Hero -->
            <section class="hero">
                <div class="hero-content">
                    <div class="badges">
                        <a
                            href="https://pkg.go.dev/github.com/peek8/prometric-go"
                            target="_blank"
                            rel="noopener"
                        >
                            <img
                                class="badge"
                                src="https://pkg.go.dev/badge/github.com/peek8/prometric-go.svg"
                                alt="Go Reference"
                            />
                        </a>
                        <a
                            href="https://goreportcard.com/report/github.com/peek8/prometric-go"
                            target="_blank"
                            rel="noopener"
                        >
                            <img
                                class="badge"
                                src="https://goreportcard.com/badge/github.com/peek8/prometric-go"
                                alt="Go Report Card"
                            />
                        </a>
                        <img
                            class="badge"
                            src="https://img.shields.io/badge/license-Apache%20License%202.0-blue"
                            alt="License: Apache-2.0"
                        />
                    </div>

                    <h1>Prometric-go</h1>

                    <p class="hero-subtitle">
                        A lightweight and configurable <strong
                            >Prometheus instrumentation library</strong
                        > for Go web applications. Add standardized HTTP, health,
                        and business-level metrics with minimal code.
                    </p>

                    <div class="hero-actions">
                        <a href="#quickstart" class="btn btn-primary btn-lg">
                            Quick Start
                            <svg
                                width="16"
                                height="16"
                                viewBox="0 0 24 24"
                                fill="none"
                                stroke="currentColor"
                                stroke-width="2"
                                ><path d="M5 12h14M12 5l7 7-7 7"></path></svg
                            >
                        </a>
                        <div class="install-cmd">
                            <span>$</span>
                            <code
                                >go get github.com/peek8/prometric-go/prometrics</code
                            >
                            <button
                                onclick="copyInstall()"
                                title="Copy to clipboard"
                            >
                                <svg
                                    width="18"
                                    height="18"
                                    viewBox="0 0 24 24"
                                    fill="none"
                                    stroke="currentColor"
                                    stroke-width="2"
                                    ><rect
                                        x="9"
                                        y="9"
                                        width="13"
                                        height="13"
                                        rx="2"></rect><path
                                        d="M5 15H4a2 2 0 01-2-2V4a2 2 0 012-2h9a2 2 0 012 2v1"
                                    ></path></svg
                                >
                            </button>
                        </div>
                    </div>
                </div>
            </section>

            <!-- Features -->
            <section id="features" class="features">
                <div class="section-header">
                    <p class="section-label">Features</p>
                    <h2>Everything you need for observability</h2>
                    <p class="section-desc">
                        Comprehensive metrics collection with plug-and-play
                        middleware for net/http and Gin frameworks.
                    </p>
                </div>

                <div class="features-grid">
                    <article class="feature-card">
                        <div class="feature-icon">🌐</div>
                        <h3>HTTP Middleware</h3>
                        <p>
                            Automatically instrument all your HTTP handlers with
                            comprehensive request metrics.
                        </p>
                        <ul class="metrics-list">
                            <li>
                                <span class="metric-name"
                                    >http_requests_total</span
                                >
                            </li>
                            <li>
                                <span class="metric-name"
                                    >http_request_duration_seconds</span
                                >
                            </li>
                            <li>
                                <span class="metric-name"
                                    >http_in_flight_requests</span
                                >
                            </li>
                            <li>
                                <span class="metric-name"
                                    >http_request_size_bytes</span
                                >
                            </li>
                            <li>
                                <span class="metric-name"
                                    >http_response_size_bytes</span
                                >
                            </li>
                        </ul>
                    </article>

                    <article class="feature-card">
                        <div class="feature-icon">💓</div>
                        <h3>Health Middleware</h3>
                        <p>
                            Monitor your application's health with real-time
                            system metrics and resource usage.
                        </p>
                        <ul class="metrics-list">
                            <li>
                                <span class="metric-name"
                                    >app_uptime_seconds</span
                                >
                            </li>
                            <li>
                                <span class="metric-name"
                                    >app_cpu_usage_percent</span
                                >
                            </li>
                            <li>
                                <span class="metric-name"
                                    >app_allocated_memory</span
                                >
                            </li>
                            <li>
                                <span class="metric-name">app_go_routines</span>
                            </li>
                            <li>
                                <span class="metric-name"
                                    >app_garbage_collections_count</span
                                >
                            </li>
                        </ul>
                    </article>

                    <article class="feature-card">
                        <div class="feature-icon">📦</div>
                        <h3>CRUD Monitoring</h3>
                        <p>
                            Track business-level operations with utility
                            functions for object lifecycle metrics.
                        </p>
                        <ul class="metrics-list">
                            <li>
                                <span class="metric-name"
                                    >crud_operations_total</span
                                >
                            </li>
                            <li>
                                <span class="metric-name"
                                    >object_operation_duration_seconds</span
                                >
                            </li>
                            <li>
                                <span class="metric-name">object_count</span>
                            </li>
                        </ul>
                    </article>
                </div>
            </section>

            <!-- Code Examples -->
            <section id="quickstart" class="code-section">
                <div class="code-section-content">
                    <div class="section-header">
                        <p class="section-label">Quick Start</p>
                        <h2>Get started in minutes</h2>
                        <p class="section-desc">
                            Simple integration with your existing Go web
                            framework of choice.
                        </p>
                    </div>

                    <div class="code-tabs">
